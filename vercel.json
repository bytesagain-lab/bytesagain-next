{
  "redirects": [
    {
      "source": "/skills/(.*)",
      "destination": "/skill/$1",
      "permanent": true
    },
    {
      "source": "/(202[4-6])/(.*)",
      "destination": "/articles",
      "permanent": true
    },
    {
      "source": "/blog/(.*)",
      "destination": "/articles",
      "permanent": true
    },
    {
      "source": "/category/(.*)",
      "destination": "/articles",
      "permanent": true
    },
    {
      "source": "/tag/(.*)",
      "destination": "/articles",
      "permanent": true
    },
    {
      "source": "/author/(.*)",
      "destination": "/articles",
      "permanent": true
    },
    {
      "source": "/page/(.*)",
      "destination": "/articles",
      "permanent": true
    },
    {
      "source": "/feed",
      "destination": "/articles",
      "permanent": true
    },
    {
      "source": "/(.*)\\.php",
      "destination": "/articles",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/skill/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=43200, stale-while-revalidate=86400"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=43200, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/article/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=14400, stale-while-revalidate=86400"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=14400, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/use-case/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=21600, stale-while-revalidate=86400"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=21600, stale-while-revalidate=86400"
        }
      ]
    }
  ],
